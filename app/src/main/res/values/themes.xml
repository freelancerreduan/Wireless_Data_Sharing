<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ReduanSmartInfo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_navy</item>
    </style>

    <!-- Android 12+ system splash (backported by core-splashscreen) -->
    <style name="Theme.ReduanSmartInfo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.ReduanSmartInfo</item>
    </style>
</resources>
